# PostgreSQL
DATABASE_URL=postgres://shop:shop@localhost:5432/shop
APP_URL=http://localhost:3000

# Ключ шифрования ключей активации и данных продавцов: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Платежный провайдер ELQR. Пока провайдер не выбран: mock
PAYMENT_PROVIDER=mock
MOCK_ELQR_WEBHOOK_SECRET=

# Бизнес-параметры (ТЗ)
ORDER_TTL_MINUTES=15
MAX_ORDERS_PER_EMAIL_PER_HOUR=3
# Порог ручной проверки в тыйынах, [__] сом — не утвержден
# REVIEW_THRESHOLD_MINOR=

# Секрет для вызова /api/cron/expire-orders
CRON_SECRET=

# Сессии: подпись cookie (openssl rand -hex 32) и срок жизни, дней
SESSION_SECRET=
SESSION_TTL_DAYS=30

# Steam Web API: имя и аватар после входа через Steam
STEAM_API_KEY=
# real — проверки trade-ссылки, инвентаря и трейд-бана через Steam; mock — только для разработки без ключа
STEAM_CHECKS=real

# Письма: dev — не отправляются, видны на /dev/mail; smtp — реальная отправка
EMAIL_TRANSPORT=dev
EMAIL_FROM="PlayGround <no-reply@example.kg>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Воркер Steam-ботов (npm run worker, отдельный процесс). Секреты ботов — только в env воркера, не сайта!
BOT_MODE=mock
# STEAM_BOTS=[{"name":"bot1","username":"","password":"","sharedSecret":"","identitySecret":""}]
# FLOAT_INSPECT_API=
# MOCK_ACCEPT_SECONDS=30

# Приватное хранилище документов продавцов (фото паспорта и селфи). local — только с PAYMENT_PROVIDER=mock
FILE_STORAGE=local
# FILE_STORAGE=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Курс USD → сом для рыночной цены Steam (проверка цены P2P-лота)
USD_KGS_RATE=87.5
